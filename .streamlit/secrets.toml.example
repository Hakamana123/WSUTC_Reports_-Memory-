# Copy this file to  .streamlit/secrets.toml  and fill in the values.
# secrets.toml is git-ignored — it must never be committed.
#
# The [gcp_service_account] block is the downloaded JSON key, field for field.
# Open the .json in a text editor and copy each value across.

[gcp_service_account]
type = "service_account"
project_id = "PASTE"
private_key_id = "PASTE"
# Paste the key between the triple quotes, including the BEGIN/END lines,
# with real line breaks (exactly as it appears in the JSON, but without the
# surrounding "..." and without the literal \n — just press Enter).
private_key = """
-----BEGIN PRIVATE KEY-----
PASTE
-----END PRIVATE KEY-----
"""
client_email = "PASTE@PASTE.iam.gserviceaccount.com"
client_id = "PASTE"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "PASTE"
universe_domain = "googleapis.com"

[sheet]
# The long string between /d/ and /edit in the Sheet's URL.
id = "PASTE_SHEET_ID"
worksheet = "working"

# Workload Management — optional. Its tabs (wl_staff, wl_allocations,
# wl_adjustments, wl_log) go in the Sheet set in workload_store.DEFAULT_SHEET_ID;
# set this only to use a different one (share it with the service account too).
# [workload]
# sheet_id = "PASTE_OTHER_SHEET_ID"

[app]
# Comma-separated names shown in the "last saved by" stamp / picked in the UI.
# Optional — leave as-is for now.
reviewers = "Josiah, Chris, Nat"

# Streamlit Community Cloud's free tier only offers PUBLIC apps (no
# Streamlit-managed login) — this is the shared-password gate in auth.py.
# Give it out only to the reviewers; change it any time by editing this
# value here and in the Streamlit Cloud app's own Secrets box.
access_password = "PASTE_A_SHARED_PASSWORD"
